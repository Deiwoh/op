-- Cada clave de Features = nombre exacto de la opción.
-- Firma: function(on: boolean, sub: string|nil)
-- Guarda siempre el estado original para poder deshacer.
local char = function() return player.Character end
local hum = function()
	local c = char()
	return c and c:FindFirstChildOfClass("Humanoid")
end
local root = function()
	local c = char()
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- guarda/restaura propiedades (una sola vez por sesión)
-- declarados aquí (arriba) porque restoreAll() los necesita
local store = {}
local matStore  = {}   -- [parte] = {Material=, Color=}  variante "neon"/"mat"
local matStore2 = {}   -- variante "tex"
local noclipSaved = {} -- [parte] = CanCollide original
local savedFonts = {}  -- [instancia] = fuente original

local function save(key, obj, prop)
	if store[key] == nil then
		local ok, v = pcall(function() return obj[prop] end)
		if ok then store[key] = {obj = obj, prop = prop, value = v} end
	end
end
local function restore(key)
	local e = store[key]
	if e then
		if e.snap then
			for _, s in ipairs(e.snap) do
				pcall(function() e.obj[s.prop] = s.value end)
			end
		else
			pcall(function() e.obj[e.prop] = e.value end)
		end
		store[key] = nil
	end
end

-- restaura TODO lo guardado (se usa antes de re-aplicar al reaparecer,
-- para que los objetos viejos destruidos no contaminen las claves)
local function restoreAll()
	for k in pairs(store) do
		restore(k)
	end
	for _, bag in ipairs({matStore, matStore2}) do
		for p, snap in pairs(bag) do
			pcall(function()
				p.Material = snap.Material
				p.Color = snap.Color
			end)
			bag[p] = nil
		end
	end
	for p, v in pairs(noclipSaved) do
		pcall(function() p.CanCollide = v end)
		noclipSaved[p] = nil
	end
	for inst, f in pairs(savedFonts) do
		pcall(function() inst.Font = f end)
		savedFonts[inst] = nil
	end
end

-- guarda/restaura una lista de props de un objeto
local function saveList(key, obj, props)
	if store[key] == nil then
		local snap = {}
		for _, p in ipairs(props) do
			local ok, v = pcall(function() return obj[p] end)
			if ok then snap[#snap + 1] = {prop = p, value = v} end
		end
		store[key] = {obj = obj, snap = snap}
	end
end
local function restoreList(key)
	local e = store[key]
	if not e then return end
	for _, s in ipairs(e.snap) do
		pcall(function() e.obj[s.prop] = s.value end)
	end
	store[key] = nil
end

-- conexiones/loops que se cortan al apagar
local conns = {}
local function stop(key)
	local c = conns[key]
	if c then
		if typeof(c) == "RBXScriptConnection" then c:Disconnect()
		elseif typeof(c) == "table" then for _, x in ipairs(c) do x:Disconnect() end end
		conns[key] = nil
	end
end
local function eachFrame(key, fn)
	stop(key)
	conns[key] = game:GetService("RunService").Heartbeat:Connect(fn)
end

-- aplica/cambia material+color de la humanoid y lo restaura
-- (clave por instancia: sobrevive a reapariciones; matStore/matStore2
--  se declaran arriba junto a store)
local function charMat(key, material, color)
	local c = char()
	if not c then return end
	local bag = (key == "tex") and matStore2 or matStore
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
			if bag[p] == nil then
				bag[p] = {Material = p.Material, Color = p.Color}
			end
			p.Material = material
			if color then p.Color = color end
		end
	end
end
local function restoreCharMat(key)
	local bag = (key == "tex") and matStore2 or matStore
	for p, snap in pairs(bag) do
		pcall(function()
			p.Material = snap.Material
			p.Color = snap.Color
		end)
		bag[p] = nil
	end
end

