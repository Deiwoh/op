				sb.MouseButton1Click:Connect(function()
					for j, other in ipairs(entry.SubButtons) do
						other.Grad.Enabled = false
						other.Stroke.Color = Color3.fromRGB(90, 28, 49)
						other.Label.TextColor3 = THEME.Text
						other.Selected = false
					end
					sGrad.Enabled = true
					sGrad.Color = ColorSequence.new(accentGlow(), accentColor())
					sStroke.Color = Color3.fromRGB(255, 227, 238)
					sb:FindFirstChildOfClass("TextLabel").TextColor3 = THEME.White
					entry.SelectedIndex = i
					entry.SelectedText = s
					if not item.on then
						item.on = true
						entry:SetOn(true, true)
					end
					notify(item.n .. " → " .. s)
					-- re-ejecutar la opción con la nueva sub-selección
					local fn = Features[item.n]
					if fn then
						local ok, err = pcall(fn, true, s)
						if not ok then warn("[HelloKitty:" .. item.n .. "] " .. tostring(err)) end
					end
					if Panel.Callbacks[item.n] then pcall(Panel.Callbacks[item.n], true, s) end
				end)

				entry.SubButtons[i] = {
					Button = sb, Grad = sGrad, Stroke = sStroke,
					Label = sb:FindFirstChildOfClass("TextLabel"),
				}
			end
			subFrame.Size = UDim2.new(1, -14, 0, #item.sub * SUB_H + 2)
		end

		---------------- estado ON / OFF ----------------
		-- sólo repinta (sin ejecutar efectos): usado por ChangeGuiColor
		function entry:Style()
			row.BackgroundColor3 = item.on and accentColor() or THEME.Row
			rowGrad.Enabled = item.on
			rowGrad.Color = ColorSequence.new(accentGlow(), accentColor())
			rowStroke.Color = item.on and Color3.fromRGB(255, 227, 238) or THEME.Border
			rowStroke.Transparency = item.on and 0.2 or 0.35
			nameLabel.TextColor3 = item.on and THEME.White or THEME.Text
			nameLabel.Font = item.on and Enum.Font.GothamBold or Enum.Font.Gotham
			dot.BackgroundColor3 = item.on and THEME.DotOn or THEME.DotOff
		end

		function entry:SetOn(state, silent)
			item.on = state and true or false
			entry:Style()

			if item.on then
				activeSet[item.n] = true
			else
				activeSet[item.n] = nil
			end
			refreshToggled()

			if not silent then
				notify(item.n .. (item.on and " ON" or " OFF"))
				-- HitSounds: ping al alternar
				if activeSet["HitSounds"] and Panel._ping then
					pcall(function() Panel._ping:Play() end)
				end
			end

			-- ejecutar la funcionalidad asociada a esta opción
			local fn = Features[item.n]
			if fn then
				local ok, err = pcall(fn, item.on, entry.SelectedText or (item.sub and item.sub[1]))
				if not ok then
					warn("[HelloKitty:" .. item.n .. "] " .. tostring(err))
					notify(item.n .. ": error")
				end
			end

			if item.callback then
				task.spawn(item.callback, item.on)
			end
			if Panel.Callbacks[item.n] then
				task.spawn(Panel.Callbacks[item.n], item.on)
			end
		end

		---------------- clic en la fila ----------------
		row.MouseButton1Click:Connect(function()
			entry:SetOn(not item.on)
		end)

		---------------- expandir / contraer ----------------
		if chev then
			chev.MouseButton1Click:Connect(function()
				entry.Open = not entry.Open
				subFrame.Visible = entry.Open
				for _, sb in ipairs(entry.SubButtons) do
					sb.Button.Visible = entry.Open
				end
				chev.Text = entry.Open and "▲" or "▼"
				computeHeight(entry)
				eFrame.Size = UDim2.new(1, -6, 0, entry.Height - GAP)
				relayout(win)
			end)
		end

		---------------- REORDENAR arrastrando el grip ----------------
		grip.Active = true
		local dragStartY, startOffset, startIndex, dragging

		grip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStartY = input.Position.Y
				startOffset = entry.LayoutY
				startIndex = indexOf(win.Entries, entry)
				row.BackgroundColor3 = accentColor()
				eFrame.ZIndex = 50
				row.ZIndex = 51
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end

			local delta = input.Position.Y - dragStartY
			local newOffset = startOffset + delta
			local idx = indexOf(win.Entries, entry)
			if not idx then return end

			-- ¿pasó por encima del vecino de arriba?
			local prev = win.Entries[idx - 1]
			if prev and newOffset < prev.LayoutY + prev.Height * 0.5 then
				table.remove(win.Entries, idx)
				table.insert(win.Entries, idx - 1, entry)
				startOffset -= prev.Height
				relayout(win)
				return
			end

			-- ¿pasó por encima del vecino de abajo?
			local nextE = win.Entries[idx + 1]
			if nextE and (newOffset + entry.Height) > (nextE.LayoutY + nextE.Height * 0.5) then
				table.remove(win.Entries, idx)
				table.insert(win.Entries, idx + 1, entry)
				startOffset += nextE.Height
				relayout(win)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch) then
				dragging = false
				eFrame.ZIndex = 1
				row.ZIndex = 1
				-- sólo repintar: reordenar NO debe re-ejecutar la función
				entry:Style()
				notify("posición actualizada")
			end
		end)

		entry.Frame = eFrame
		entry.Row = row
		return entry
	end

	-- crear las opciones del cfg
	for _, item in ipairs(cfg.items or {}) do
		local entry = buildEntry(item)
		win.Entries[#win.Entries + 1] = entry
	end

	-- estado inicial de cada una
	for _, e in ipairs(win.Entries) do
		computeHeight(e)
		e:SetOn(e.Item.on, true)
	end
	relayout(win)

	-- mover ventana
	makeDraggable(frame, hdr, screenSize())

	return win
end

