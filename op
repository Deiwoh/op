local function applyActive()
	quietNotify = true          -- no spamear toasts al cargar/reaparecer
	for _, win in ipairs(Panel.Windows) do
		for _, e in ipairs(win.Entries) do
			if e.Item.on and Features[e.Item.n] then
				local ok, err = pcall(Features[e.Item.n], true,
					e.SelectedText or (e.Item.sub and e.Item.sub[1]))
				if not ok then
					warn("[HelloKitty:init " .. e.Item.n .. "] " .. tostring(err))
				end
			end
		end
	end
	quietNotify = false
end
applyActive()

