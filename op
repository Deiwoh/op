Features["PlayerList"] = function(on)
	-- panel flotante con la lista de jugadores (vida + distancia)
	if on then
		if not Panel.playerFrame then
			local f = new("Frame", {
				Name = "PlayerList", AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -14, 0, 345),
				Size = UDim2.fromOffset(176, 150),
				BackgroundColor3 = THEME.Bg, Parent = desktop,
			})
			corner(f, 8)
			table.insert(accentStrokes, stroke(f, accentColor(), 1.5, 0.2))
			local hdrF = new("Frame", {Size = UDim2.new(1, 0, 0, 24),
				BackgroundColor3 = THEME.HeaderA, Parent = f})
			corner(hdrF, 8)
			grad(hdrF, THEME.HeaderA, THEME.HeaderB)
			new("Frame", {Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 1, -8),
				BackgroundColor3 = THEME.HeaderB, BorderSizePixel = 0, Parent = hdrF})
			label(hdrF, "Players", UDim2.new(1, -10, 1, 0), UDim2.fromOffset(9, 0),
				THEME.White, nil, true)
			local bodyF = new("ScrollingFrame", {
				Size = UDim2.new(1, -8, 1, -30), Position = UDim2.fromOffset(4, 27),
				BackgroundTransparency = 1, BorderSizePixel = 0,
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 4, ScrollBarImageColor3 = accentColor(),
				Parent = f,
			})
			new("UIListLayout", {Padding = UDim.new(0, 3), Parent = bodyF})
			Panel.playerFrame = f
			Panel.playerBody = bodyF
		end
		Panel.playerFrame.Visible = true

		local bodyF = Panel.playerBody
		local function rebuild()
			if not bodyF or not bodyF.Parent then return end
			for _, ch in ipairs(bodyF:GetChildren()) do
				if ch:IsA("TextLabel") or ch:IsA("Frame") then ch:Destroy() end
			end
			local rp = root()
			for i, pl in ipairs(game:GetService("Players"):GetPlayers()) do
				local c = pl.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				local pr = c and c:FindFirstChild("HumanoidRootPart")
				local hp = h and math.floor(h.Health) or 0
				local dist = (rp and pr) and math.floor((rp.Position - pr.Position).Magnitude) or 0
				local r = new("TextLabel", {
					Size = UDim2.new(1, -4, 0, 24), LayoutOrder = i,
					BackgroundColor3 = pl == player and Color3.fromRGB(90, 30, 55) or THEME.Row,
					Text = string.format("%s  ·  %d hp  ·  %dm", pl.Name:sub(1, 14), hp, dist),
					TextColor3 = THEME.Text, Font = Enum.Font.Gotham, TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left, Parent = bodyF,
				})
				corner(r, 4)
				new("UIPadding", {PaddingLeft = UDim.new(0, 7), Parent = r})
			end
		end
		rebuild()
		eachFrame("playerlist", function() rebuild() end)
	else
		stop("playerlist")
		if Panel.playerFrame then Panel.playerFrame.Visible = false end
	end
end

