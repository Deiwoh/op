-- Tamaño de la pantalla.
-- OJO: UserInputService:GetWindowSize() NO EXISTE en Roblox. Esa llamada
-- lanzaba "attempt to call a nil value (method 'GetWindowSize')" y mataba
-- el script justo al crear la barra superior: por eso no cargaban las
-- ventanas ni funcionaba ninguna opción. Usamos la cámara / el ScreenGui.
local function screenSize()
	local s = nil
	pcall(function()
		local cam = workspace.CurrentCamera
		if cam then s = cam.ViewportSize end
	end)
	if not s or s.X <= 0 or s.Y <= 0 then
		pcall(function() s = gui.AbsoluteSize end)
	end
	if not s or s.X <= 0 or s.Y <= 0 then
		s = Vector2.new(1280, 720)
	end
	return s
end

local zTop = 10

local function makeDraggable(frame, handle, bounds)
	handle.Active = true
	local dragging, dragStart, startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			zTop += 1
			frame.ZIndex = zTop                    -- traer al frente
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart            -- delta => insensible al inset
			local x = startPos.X.Offset + delta.X
			local y = startPos.Y.Offset + delta.Y
			if bounds then
				x = math.clamp(x, -WIN_W + 60, bounds.X - 60)
				y = math.clamp(y, 0, bounds.Y - 30)
			end
			frame.Position = UDim2.fromOffset(x, y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

