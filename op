-- Muestra cualquier error DEL SCRIPT en pantalla (y en Output), para que
-- nunca se quede "en blanco" sin saber qué falló.
local function HK_ReportError(err)
	local msg = tostring(err)
	warn("[HelloKitty ERROR] " .. msg)
	local function show(holder)
		if not holder then error("sin contenedor") end

		local old = holder:FindFirstChild("HelloKittyError")
		if old then old:Destroy() end

		local g = Instance.new("ScreenGui")
		g.Name = "HelloKittyError"
		g.ResetOnSpawn = false
		g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		g.Parent = holder

		local box = Instance.new("Frame")
		box.AnchorPoint = Vector2.new(0.5, 0)
		box.Position = UDim2.new(0.5, 0, 0, 70)
		box.Size = UDim2.new(1, -60, 0, 280)
		box.BackgroundColor3 = Color3.fromRGB(95, 0, 30)
		box.BorderSizePixel = 0
		box.Parent = g
		local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 10); bc.Parent = box

		local ttl = Instance.new("TextLabel")
		ttl.Size = UDim2.new(1, -20, 0, 24); ttl.Position = UDim2.fromOffset(12, 8)
		ttl.BackgroundTransparency = 1
		ttl.Text = "ERROR  ·  Hello Kitty Panel"
		ttl.TextColor3 = Color3.fromRGB(255, 150, 185)
		ttl.Font = Enum.Font.GothamBold; ttl.TextSize = 15
		ttl.TextXAlignment = Enum.TextXAlignment.Left
		ttl.Parent = box

		local body = Instance.new("TextLabel")
		body.Size = UDim2.new(1, -24, 1, -50); body.Position = UDim2.fromOffset(12, 36)
		body.BackgroundTransparency = 1
		body.Text = msg
		body.TextColor3 = Color3.new(1, 1, 1)
		body.Font = Enum.Font.Code; body.TextSize = 14
		body.TextXAlignment = Enum.TextXAlignment.Left
		body.TextYAlignment = Enum.TextYAlignment.Top
		body.TextWrapped = true
		body.Parent = box

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.fromOffset(74, 26); btn.Position = UDim2.new(1, -86, 0, 6)
		btn.BackgroundColor3 = Color3.fromRGB(255, 90, 140)
		btn.Text = "Cerrar"; btn.TextColor3 = Color3.new(1, 1, 1)
		btn.Font = Enum.Font.GothamBold; btn.TextSize = 13
		btn.Parent = box
		local bcn = Instance.new("UICorner"); bcn.CornerRadius = UDim.new(0, 8); bcn.Parent = btn
		btn.MouseButton1Click:Connect(function() g:Destroy() end)
		return true
	end

	-- 1) PlayerGui (siempre accesible desde un LocalScript)
	local ok = pcall(function()
		local lp = Players.LocalPlayer
		show(lp and lp:FindFirstChildOfClass("PlayerGui"))
	end)
	-- 2) reserva: CoreGui
	if not ok then
		pcall(function() show(game:GetService("CoreGui")) end)
	end
end

