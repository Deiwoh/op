local accentColor = function() return PALETTES[CONFIG.AccentIndex].Accent end
local accentGlow  = function() return PALETTES[CONFIG.AccentIndex].Glow end

local function setAccent(color, glow)
	-- bordes de ventanas y paneles
	for _, st in ipairs(accentStrokes) do
		if st.Parent then
			TweenService:Create(st, TweenInfo.new(0.25), {Color = color}):Play()
		end
	end
	-- cabeceras + repintar filas (SIN re-ejecutar efectos)
	for _, win in ipairs(Panel.Windows) do
		local g = win.Header:FindFirstChildOfClass("UIGradient")
		if g then TweenService:Create(g, TweenInfo.new(0.25),
			{Color = ColorSequence.new(THEME.HeaderA, color)}):Play() end
		for _, e in ipairs(win.Entries) do
			if e.Item.on and e.Style then e:Style() end
		end
	end
end

-- relayout: coloca cada opción y redimensiona la ventana (con scroll máximo)
local function relayout(win)
	local y = 0
	for _, e in ipairs(win.Entries) do
		e.LayoutY = y
		e.Frame.Position = UDim2.fromOffset(0, y)
		y += e.Height
	end
	local maxH = math.max(160, screenSize().Y - 150)
	local bodyH = win.Minimized and 0 or math.min(y, maxH)
	win.Body.Visible = bodyH > 0
	win.Body.Size = UDim2.fromOffset(WIN_W, bodyH)
	win.Body.CanvasSize = UDim2.fromOffset(0, y)
	win.Frame.Size = UDim2.fromOffset(WIN_W, bodyH + TOP_H)
end

local function computeHeight(entry)
	local h = ITEM_H + GAP
	if entry.Open and entry.Item.sub then
		h += #entry.Item.sub * SUB_H + 2
	end
	entry.Height = h
end

local function indexOf(list, value)
	for i, v in ipairs(list) do
		if v == value then return i end
	end
	return nil
end

